{
  "name": "cyron-uninstaller",
  "version": "0.2.1",
  "description": "Windows Application Uninstaller, Disk Analyzer & Cleaner",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Chryypt",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ry0x7/cyron-uninstaller.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:desktop": "node scripts/desktop-e2e.mjs",
    "docs:check": "node scripts/verify-docs.mjs",
    "landing:sync": "node scripts/sync-landing.mjs",
    "landing:check": "node scripts/sync-landing.mjs --check",
    "prepare": "powershell -ExecutionPolicy Bypass -File scripts/setup-git-hooks.ps1",
    "tauri": "node scripts/msvc-env.mjs npx tauri",
    "dev:desktop": "node scripts/msvc-env.mjs npx tauri dev",
    "build:desktop": "node scripts/msvc-env.mjs npx tauri build --debug --no-bundle",
    "build:unsigned": "node scripts/msvc-env.mjs npx tauri build",
    "build:signed": "node scripts/msvc-env.mjs npx tauri build && powershell -ExecutionPolicy Bypass -File scripts/sign-build.ps1",
    "build:dev-signed": "node scripts/msvc-env.mjs npx tauri build && powershell -ExecutionPolicy Bypass -File scripts/sign-build.ps1",
    "verify:signatures": "powershell -ExecutionPolicy Bypass -File scripts/verify-signatures.ps1 -RunNegativeTests",
    "verify:metadata": "powershell -ExecutionPolicy Bypass -File scripts/verify-windows-metadata.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/json-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^10.2.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-service": "^1.5.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12",
    "webdriverio": "^9.32.0"
  }
}
